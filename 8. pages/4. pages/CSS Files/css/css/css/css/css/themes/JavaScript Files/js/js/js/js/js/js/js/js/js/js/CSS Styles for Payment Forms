/* ethiopian-payments.css */
/* Styles for Ethiopian payment forms and components */

.ethiopian-payment-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

.payment-method-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
    margin-bottom: 30px;
}

.payment-method-card {
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: white;
}

.payment-method-card:hover {
    border-color: #ff0042;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 0, 66, 0.1);
}

.payment-method-card.selected {
    border-color: #ff0042;
    background-color: rgba(255, 0, 66, 0.05);
}

.payment-method-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
    color: #ff0042;
}

.payment-method-name {
    font-weight: bold;
    margin-bottom: 5px;
    color: #2C2C2C;
}

.payment-method-desc {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 10px;
}

.payment-form {
    background: white;
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
}

.form-group {
    margin-bottom: 25px;
}

.form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: #2C2C2C;
}

.form-control {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
}

.form-control:focus {
    outline: none;
    border-color: #ff0042;
    box-shadow: 0 0 0 3px rgba(255, 0, 66, 0.1);
}

.form-control.error {
    border-color: #ff0042;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.bank-selector {
    position: relative;
}

.bank-dropdown {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #ddd;
    border-radius: 6px;
    background: white;
    font-size: 1rem;
    cursor: pointer;
}

.bank-dropdown:focus {
    outline: none;
    border-color: #ff0042;
}

.bank-logo {
    width: 30px;
    height: 30px;
    object-fit: contain;
    margin-right: 10px;
}

.amount-container {
    position: relative;
}

.currency-symbol {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-weight: bold;
    color: #666;
}

.currency-input {
    padding-left: 40px !important;
}

.fee-display {
    background: #F5F6FA;
    border-radius: 6px;
    padding: 15px;
    margin-top: 10px;
    border-left: 4px solid #F39C12;
}

.fee-display div {
    margin-bottom: 5px;
}

.qr-code-container {
    text-align: center;
    padding: 20px;
    border: 2px dashed #ddd;
    border-radius: 10px;
    margin: 20px 0;
}

.qr-code {
    max-width: 200px;
    margin: 0 auto 20px;
}

.qr-instruction {
    font-size: 0.9rem;
    color: #666;
    margin-top: 10px;
}

.payment-summary {
    background: #F5F6FA;
    border-radius: 10px;
    padding: 25px;
    margin: 30px 0;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid #ddd;
}

.summary-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
}

.summary-total {
    font-size: 1.2rem;
    font-weight: bold;
    color: #ff0042;
}

.submit-btn {
    background: #ff0042;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 15px 30px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
    transition: background 0.3s ease;
}

.submit-btn:hover {
    background: #e0003a;
}

.submit-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
}

.payment-history {
    margin-top: 40px;
}

.transaction-card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 15px;
    border-left: 4px solid #ff0042;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.transaction-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.transaction-id {
    font-family: monospace;
    color: #666;
    font-size: 0.9rem;
}

.transaction-amount {
    font-weight: bold;
    font-size: 1.2rem;
    color: #ff0042;
}

.transaction-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    font-size: 0.9rem;
}

.transaction-detail span:first-child {
    color: #666;
    margin-right: 5px;
}

.transaction-status {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
}

.status-completed {
    background: #d4edda;
    color: #155724;
}

.status-pending {
    background: #fff3cd;
    color: #856404;
}

.status-failed {
    background: #f8d7da;
    color: #721c24;
}

/* Mobile money specific */
.mobile-money-providers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
    margin-top: 15px;
}

.provider-card {
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    padding: 15px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
}

.provider-card:hover {
    border-color: #F39C12;
}

.provider-card.selected {
    border-color: #F39C12;
    background: rgba(243, 156, 18, 0.05);
}

.provider-logo {
    max-width: 50px;
    height: 30px;
    object-fit: contain;
    margin-bottom: 10px;
}

.ussd-code {
    font-family: monospace;
    background: #f0f0f0;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.9rem;
    color: #ff0042;
}

/* Responsive design */
@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .payment-method-selector {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .transaction-details {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .payment-method-selector {
        grid-template-columns: 1fr;
    }
    
    .payment-form {
        padding: 20px;
    }
    
    .mobile-money-providers {
        grid-template-columns: repeat(2, 1fr);
    }
}
